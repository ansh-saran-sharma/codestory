     "calls_project": [],
     "reach_depth": 2,
     "source": "def endpoint(path):\n    \"\"\"Collapse ids so /orders/123 and /orders/456 count together.\"\"\"\n    return re.sub(r\"/\\d+\", \"/:id\", path.split(\"?\")[0])"
    },
