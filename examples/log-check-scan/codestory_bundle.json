     "calls_project": [],
     "reach_depth": 1,
     "source": "def parse(lines):\n    \"\"\"Turn raw log lines into dicts; skip lines that don't match.\"\"\"\n    for line in lines:\n        m = LINE.search(line)\n        if m:\n            d = m.groupdict()\n            d[\"status\"] = int(d[\"status\"])\n            yield d"
    },
