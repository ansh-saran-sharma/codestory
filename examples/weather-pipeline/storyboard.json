      "sublabel": "etl/clean.py",
      "code": {
       "file": "etl/clean.py",
       "line": 4,
       "snippet": "def to_celsius(df):\n    \"\"\"Some stations report Fahrenheit; convert them.\"\"\"\n    df = df.copy()\n    f = df[\"unit\"] == \"F\"\n    df.loc[f, \"temp\"] = (df.loc[f, \"temp\"] - 32) * 5 / 9\n    df[\"unit\"] = \"C\"\n    return df",
       "highlight": [
        7,
        8
       ]
      }
     },
