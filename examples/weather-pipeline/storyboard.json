   "actor": {
    "kind": "function",
    "label": "daily_summary()",
    "sublabel": "etl/transform.py",
    "code": {
     "file": "etl/transform.py",
     "line": 10,
     "snippet": "def daily_summary(df):\n    \"\"\"One row per station per day: min, max, mean temperature.\"\"\"\n    df = df.assign(day=df[\"timestamp\"].dt.date)\n    out = (df.groupby([\"station_id\", \"name\", \"region\", \"day\"])[\"temp\"]\n             .agg([\"min\", \"max\", \"mean\", \"count\"]).reset_index())\n    out[\"mean\"] = out[\"mean\"].round(2)\n    return out",
     "highlight": [
      13,
      14
     ]
    }
   },
   "outputs": [
    {
     "kind": "data",
     "label": "summary",
     "data": {
      "rows": 24,
      "cols": 8,
      "columns": [
       "station_id",
       "name",
       "region",
